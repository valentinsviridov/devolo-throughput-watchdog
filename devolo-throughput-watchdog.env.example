# Public iperf3 server host and port range. Some examples can be found here: https://iperf.fr/iperf-servers.php
DW_IPERF_SERVER=iperf.example.com
DW_IPERF_PORTS=5201-5205
DW_IPERF_TRIES=5
DW_IPERF_CONNECT_TIMEOUT_MS=3000

# Local gateway IP address. Find it via: ip route show default
DW_REMOTE_PROBE=192.168.1.1

# Preferably specify the devolo adapter physically nearest to the watchdog host.
DW_DEVOLO_IP=192.168.1.20

# Collect logs first and set thresholds significantly below normal speeds.
DW_MIN_UPLOAD_MBPS=100
DW_MIN_DOWNLOAD_MBPS=100

# 64 MB in each direction, 30 seconds maximum test timeout.
# Two tests every 10 minutes gives a maximum of ~18.4 GB traffic per day.
DW_TEST_BYTES=64M
DW_IPERF_TIMEOUT_SECONDS=30
DW_INTERVAL_SECONDS=600
DW_PARALLEL_STREAMS=1

# Three degraded cycles within the observation window trigger action; 10-minute cooldown afterwards.
DW_FAIL_LIMIT=3
DW_FAIL_WINDOW_SECONDS=3600
DW_COOLDOWN_SECONDS=600
DW_INITIAL_DELAY_SECONDS=30

DW_PING_COUNT=2
DW_PING_TIMEOUT_SECONDS=2

# Keep 'log' mode during calibration; switch to 'reboot' after reviewing logs.
DW_ACTION=log

# Optional password file. Commented out by default.
# Mount as read-only volume in Compose or use Docker secrets before enabling.
# DW_PASSWORD_FILE=/etc/devolo-throughput-watchdog.password

# Require PLC-specific evidence (PHY rates) before rebooting (default: true).
DW_REQUIRE_PLC_EVIDENCE_FOR_REBOOT=true
DW_MIN_PLC_PHY_RATE_MBPS=50.0

# Circuit breaker window: max 3 reboots in 6 hours (defaults).
DW_REBOOT_WINDOW_HOURS=6.0
DW_MAX_REBOOTS_IN_WINDOW=3

# Persistent state file path.
DW_STATE_FILE=/var/lib/devolo-watchdog/state.json

# Container liveness. Max age defaults to twice DW_INTERVAL_SECONDS (minimum 90s).
DW_HEARTBEAT_FILE=/tmp/watchdog_heartbeat
# DW_HEARTBEAT_MAX_AGE_SECONDS=1200

# Delay in seconds to wait for adapter reboot completion before post-reboot verification (default: 45).
DW_POST_REBOOT_DELAY_SECONDS=45

# Logs are emitted as one JSON object per line.
DW_LOG_FORMAT=json

# Optional ntfy mobile/desktop notifications. Use a hard-to-guess topic URL for
# ntfy.sh, or an authenticated topic on your own/hosted ntfy server.
# DW_NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic
# DW_NTFY_TOKEN_FILE=/run/secrets/devolo-watchdog-ntfy-token
# DW_NTFY_TIMEOUT_SECONDS=5.0

# Optional HTTP server port for querying the current state via HTTP GET.
# DW_HTTP_PORT=61495
